      "posted_body_sha256": "41b92727c7b1f599a3baa55876a8fba4a31f8814446f4a31d0a1243fe4791f9c",
      "draft_hash_normalization": "UTF-8 with CRLF normalized to LF",
      "posted_body_hash_normalization": "Submitted UTF-8 source, terminal LF removed, before platform URL shortening",
      "submitted_body": "Organizing audio files on Android? Keep a separate backup, then test a small library with Wi-Fi and mobile data off before adding the rest.\n\nMelivra is an offline music player for local audio files.\nGoogle Play: https://play.google.com/store/apps/details?id=com.onnellab.melivra",
